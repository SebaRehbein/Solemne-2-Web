# Copia este archivo a backend/.env y completa los valores reales.
# backend/.env NUNCA se sube a git (ver .gitignore y .dockerignore).

PORT=3000

# En desarrollo local (sin Docker), Mongo corre en tu propia máquina:
# MONGO_URI=mongodb://127.0.0.1:27017/BerryBadLuck_db
#
# Con docker compose, este valor se sobrescribe automáticamente para
# apuntar al servicio "mongo" de la red interna de Docker (ver
# compose.yml, sección backend > environment). Puedes dejar aquí
# cualquiera de las dos formas: docker compose igual va a usar la suya.
MONGO_URI=mongodb://127.0.0.1:27017/BerryBadLuck_db

# Secreto para firmar los JWT de JUGADOR (cookie httpOnly sessionToken).
# Genera el tuyo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplaza_esto_con_un_secreto_largo_y_aleatorio

# Secreto SEPARADO para firmar los JWT de ADMIN (header Authorization).
# Defensa en profundidad: un token de jugador nunca podría validarse
# como admin, ni viceversa, aunque alguien manipulara el campo "role"
# a mano, porque están firmados con llaves distintas. Puede ser el
# mismo valor que JWT_SECRET si prefieres simplicidad, pero debe
# existir como variable propia (ver backend/config/jwt.js).
ADMIN_JWT_SECRET=reemplaza_esto_con_otro_secreto_largo_y_aleatorio

# Secreto para FIRMAR las cookies (cookie-parser). Es independiente de
# JWT_SECRET: protege el transporte de la cookie en sí (que el
# navegador no pueda alterar su valor sin que el backend lo detecte),
# mientras que JWT_SECRET protege el contenido del token que viaja
# dentro de esa cookie.
COOKIE_SECRET=reemplaza_esto_con_otro_secreto_largo_y_aleatorio

# development | production. Afecta si las cookies exigen HTTPS (secure)
# y otros comportamientos de Express en producción.
NODE_ENV=development
