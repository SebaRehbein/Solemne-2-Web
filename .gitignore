### --- CONFIGURACIÓN DEL PROYECTO (pnpm & Workspaces) ---
# Dependencias locales en la raíz y subcarpetas (frontend/backend)
node_modules/
**/node_modules/

# Archivos de bloqueo de paquetes que no corresponden a pnpm (opcional, si se colaron)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

### --- COMPILACIÓN Y PRODUCCIÓN ---
# Carpetas de salida de compilación (Vite, Next, etc.)
dist/
dist-ssr/
out/
.next/
build/

### --- VARIABLES DE ENTORNO (Seguridad) ---
# Jamás subir credenciales ni configuraciones locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

### --- HERRAMIENTAS DE DISEÑO DE MAPAS (Tiled) ---
# Ignorar sesiones locales de Tiled, pero MANTENER los mapas (.tmj, .tsx, .tiled-project)
*.tiled-session

### --- ENTORNO DE DESARROLLO (Editores & OS) ---
# VS Code (Mantiene extensiones recomendadas si existen)
.vscode/*
!.vscode/extensions.json

# JetBrains / IntelliJ
.idea/

# Archivos temporales de editores
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig
.history/

# Archivos del Sistema Operativo
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

### --- LOGS Y TESTING ---
logs
*.log
coverage/
.nyc_output/
.eslintcache
.stylelintcache